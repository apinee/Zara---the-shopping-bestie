# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Agora RTC + Conversational AI Engine (RESTful API key = customer id/secret)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Murf Falcon TTS (voiceId from GET https://api.murf.ai/v1/speech/voices?model=FALCON)
MURF_API_KEY=
MURF_VOICE_ID=

# Deepgram ASR
DEEPGRAM_API_KEY=

# LLM (any OpenAI-compatible chat/completions endpoint; default = Gemini)
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Public MCP URL that Agora calls (e.g. https://<subdomain>.ngrok-free.app/mcp)
MCP_PUBLIC_URL=
MCP_INTERNAL_URL=http://localhost:8001

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
